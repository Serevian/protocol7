// EXIT: 63
fun main() -> i32 {
    // Each true condition sets a bit in the result:
    (-5 < 0) * 1 +         // Bit 0: `<`  (-5 < 0 is 1)
    (3 <= 3) * 2 +         // Bit 1: `<=` 3 <= 3 is 1)
    (5 > -1) * 4 +         // Bit 2: `>`  (5 > -1 is 1)
    (-2 >= -2) * 8 +       // Bit 3: `>=` (-2 >= -2 is 1)
    (7 == 7) * 16 +        // Bit 4: `==` (7 == 7 is 1)
    (8 != 9) * 32 +        // Bit 5: `!=` (8 != 9 is 1)

    // False conditions must all return 0
    (0 < -5) +
    (4 <= 3) +
    (-1 > 5) +
    (-3 >= -2) +
    (7 == 8) +
    (9 != 9)
}
